#!/usr/bin/env bash
# ==============================================================================
# VPS PROJECTS COMMAND CENTER (CLI HUD)
# Host: white-stingray-87538 | Debian 13 Trixie | KDE Plasma 6
# ==============================================================================

CYAN="\033[1;36m"
TEAL="\033[1;32m"
YELLOW="\033[1;33m"
RED="\033[1;31m"
PURPLE="\033[1;35m"
BLUE="\033[1;34m"
GRAY="\033[0;90m"
WHITE="\033[1;37m"
RESET="\033[0m"

clear
echo -e "${CYAN}╔══════════════════════════════════════════════════════════════════════════════╗${RESET}"
echo -e "${CYAN}║                🚀 PRODUCTION VPS COMMAND CENTER & MONITOR                    ║${RESET}"
echo -e "${CYAN}║            white-stingray-87538 | Debian 13 Trixie | KDE Plasma 6            ║${RESET}"
echo -e "${CYAN}╚══════════════════════════════════════════════════════════════════════════════╝${RESET}"

# Host Metrics
UPTIME=$(uptime -p 2>/dev/null || uptime)
MEM=$(free -h | awk '/Mem:/ {print $3 "/" $2}')
DISK=$(df -h / | awk 'NR==2 {print $3 "/" $2 " (" $5 ")"}')
LOAD=$(uptime | awk -F'load average:' '{print $2}' | xargs)

echo -e "\n${BLUE}🖥️  HOST TELEMETRY${RESET}"
echo -e "  ${WHITE}Uptime:${RESET}   $UPTIME"
echo -e "  ${WHITE}Memory:${RESET}   $MEM RAM"
echo -e "  ${WHITE}Storage:${RESET}  $DISK en /dev/sda1"
echo -e "  ${WHITE}Load:${RESET}     $LOAD"
echo -e "  ${WHITE}RDP:${RESET}      Puerto 25400 (KDE Plasma 6 X11 Session)"

echo -e "\n${CYAN}📦 PRODUCTION PROJECTS STATUS${RESET}"
printf "  ${GRAY}%-22s %-12s %-10s %-14s %-18s${RESET}\n" "PROJECT" "STATUS" "PORT" "MANAGER" "ENDPOINT"
echo -e "  ${GRAY}-----------------------------------------------------------------------------${RESET}"

# Check PresWin
PRESWIN_STATUS=$(curl -s -o /dev/null -w "%{http_code}" --max-time 1.5 http://127.0.0.1:4000/ 2>/dev/null)
if [ "$PRESWIN_STATUS" = "200" ] || [ "$PRESWIN_STATUS" = "302" ]; then
    printf "  ${WHITE}%-22s${RESET} ${TEAL}%-12s${RESET} %-10s %-14s ${GRAY}%-18s${RESET}\n" "PresWin" "[ONLINE]" "4000" "PM2 (id 1)" "therodrigo.com/preswin"
else
    printf "  ${WHITE}%-22s${RESET} ${RED}%-12s${RESET} %-10s %-14s ${GRAY}%-18s${RESET}\n" "PresWin" "[OFFLINE]" "4000" "PM2 (id 1)" "therodrigo.com/preswin"
fi

# Check Portfolio
PORT_STATUS=$(curl -s -o /dev/null -w "%{http_code}" --max-time 1.5 http://127.0.0.1:3000/api/uptime 2>/dev/null)
if [ "$PORT_STATUS" = "200" ]; then
    printf "  ${WHITE}%-22s${RESET} ${TEAL}%-12s${RESET} %-10s %-14s ${GRAY}%-18s${RESET}\n" "therodrigo.com" "[ONLINE]" "3000" "PM2 (id 0)" "therodrigo.com"
else
    printf "  ${WHITE}%-22s${RESET} ${RED}%-12s${RESET} %-10s %-14s ${GRAY}%-18s${RESET}\n" "therodrigo.com" "[OFFLINE]" "3000" "PM2 (id 0)" "therodrigo.com"
fi

# Check Technical Inspection
INSP_STATUS=$(curl -s -o /dev/null -w "%{http_code}" --max-time 1.5 http://127.0.0.1:3000/technical-inspection 2>/dev/null)
if [ "$INSP_STATUS" = "200" ] || [ "$INSP_STATUS" = "301" ] || [ "$INSP_STATUS" = "302" ]; then
    printf "  ${WHITE}%-22s${RESET} ${TEAL}%-12s${RESET} %-10s %-14s ${GRAY}%-18s${RESET}\n" "Technical Inspection" "[ONLINE]" "3000" "Express Sub" "/technical-inspection"
else
    printf "  ${WHITE}%-22s${RESET} ${RED}%-12s${RESET} %-10s %-14s ${GRAY}%-18s${RESET}\n" "Technical Inspection" "[OFFLINE]" "3000" "Express Sub" "/technical-inspection"
fi

# Check TotiMigraciones
TOTI_STATUS=$(curl -s -o /dev/null -w "%{http_code}" --max-time 1.5 http://127.0.0.1:3001/ 2>/dev/null)
if [ "$TOTI_STATUS" = "200" ] || [ "$TOTI_STATUS" = "301" ] || [ "$TOTI_STATUS" = "302" ]; then
    printf "  ${WHITE}%-22s${RESET} ${TEAL}%-12s${RESET} %-10s %-14s ${GRAY}%-18s${RESET}\n" "totimigracion.es" "[ONLINE]" "3001" "Systemd" "totimigracion.es"
else
    printf "  ${WHITE}%-22s${RESET} ${RED}%-12s${RESET} %-10s %-14s ${GRAY}%-18s${RESET}\n" "totimigracion.es" "[OFFLINE]" "3001" "Systemd" "totimigracion.es"
fi

# Check Appointment Checker
CITA_STATUS=$(curl -s -o /dev/null -w "%{http_code}" --max-time 1.5 http://127.0.0.1:8090/ 2>/dev/null)
if [ "$CITA_STATUS" = "200" ] || [ "$CITA_STATUS" = "302" ]; then
    printf "  ${WHITE}%-22s${RESET} ${TEAL}%-12s${RESET} %-10s %-14s ${GRAY}%-18s${RESET}\n" "Appointment Checker" "[ONLINE]" "8090" "Systemd" "/Appointment_Checker"
else
    printf "  ${WHITE}%-22s${RESET} ${RED}%-12s${RESET} %-10s %-14s ${GRAY}%-18s${RESET}\n" "Appointment Checker" "[OFFLINE]" "8090" "Systemd" "/Appointment_Checker"
fi

# Check Nginx
NGINX_STATE=$(systemctl is-active nginx.service 2>/dev/null)
if [ "$NGINX_STATE" = "active" ]; then
    printf "  ${WHITE}%-22s${RESET} ${TEAL}%-12s${RESET} %-10s %-14s ${GRAY}%-18s${RESET}\n" "Nginx Reverse Proxy" "[ONLINE]" "80/443" "Systemd" "SSL Terminated"
else
    printf "  ${WHITE}%-22s${RESET} ${RED}%-12s${RESET} %-10s %-14s ${GRAY}%-18s${RESET}\n" "Nginx Reverse Proxy" "[OFFLINE]" "80/443" "Systemd" "SSL Terminated"
fi

echo -e "\n${PURPLE}📡 FLEET NODES (PING RADAR)${RESET}"
for node in "node-deb-01:127.0.0.1" "node-win-01:194.156.90.100" "node-win-02:194.156.90.101" "node-win-03:194.156.90.103"; do
    NAME=$(echo $node | cut -d: -f1)
    IP=$(echo $node | cut -d: -f2)
    PING_MS=$(ping -c 1 -W 1 $IP 2>/dev/null | grep -oP 'time=\K[0-9.]+')
    if [ -n "$PING_MS" ]; then
        echo -e "  • ${WHITE}$NAME${RESET} ($IP): ${TEAL}${PING_MS} ms${RESET}"
    else
        echo -e "  • ${WHITE}$NAME${RESET} ($IP): ${RED}TIMEOUT${RESET}"
    fi
done

echo -e "\n${YELLOW}⚡ QUICK ACTIONS${RESET}"
echo -e "  [1] Reiniciar PresWin (PM2)"
echo -e "  [2] Reiniciar therodrigo.com (PM2)"
echo -e "  [3] Reiniciar totimigracion.es (Systemd)"
echo -e "  [4] Recargar Nginx"
echo -e "  [5] Abrir Btop Monitor"
echo -e "  [6] Abrir PM2 Monit"
echo -e "  [7] Abrir Command Center Web (http://127.0.0.1:9090)"
echo -e "  [q] Salir"

read -p "Selecciona una opción [1-7 / q]: " opt
case "$opt" in
    1) sudo pm2 restart preswin ;;
    2) sudo pm2 restart portfolio ;;
    3) sudo systemctl restart totimigraciones.service ;;
    4) sudo systemctl reload nginx ;;
    5) btop ;;
    6) pm2 monit ;;
    7) google-chrome --app="http://127.0.0.1:9090" 2>/dev/null & ;;
    q|Q) exit 0 ;;
    *) echo "Opción no válida." ;;
esac
